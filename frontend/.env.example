# Frontend environment configuration.
#
# Copy this file to `.env` (or `.env.local`) and adjust if the API does not run on the
# default local port. Vite only exposes variables prefixed with `VITE_`, and every such
# value is inlined into the browser bundle, so it is public by definition: never put a
# MongoDB connection string, database credential or any other secret in this file.

# Base URL of the geofence API (no trailing slash, no /api/v1 suffix).
# The backend's default port is 3000, so this is the localhost development default.
VITE_API_BASE_URL=http://localhost:3000
