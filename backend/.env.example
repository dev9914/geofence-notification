# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.
#
# Every variable below is optional in the schema, EXCEPT MONGODB_URI in practice: the server
# refuses to start without it. The defaults shown are what the application uses when the
# variable is unset.

# HTTP port the Express server listens on (default 3000).
PORT=3000

# One of development | test | production (default development).
# Set NODE_ENV=test to run the test suite; tests never connect to a database.
NODE_ENV=development

# MongoDB Atlas connection string. Required to start the server.
# Must be a mongodb:// or mongodb+srv:// URI pointing at Atlas: there is deliberately no
# fallback to a local MongoDB instance. Replace the placeholder with your own Atlas URI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Origin allowed by CORS; must start with http:// or https:// (default http://localhost:5173).
FRONTEND_URL=http://localhost:5173
